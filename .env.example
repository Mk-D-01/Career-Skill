# Optional: enables a durable, shared scoreboard across all visitors.
# Without these, scores still work but are kept in memory and reset on redeploy/cold start.
#
# Get these for free from a Vercel-native Redis database:
#   Vercel dashboard -> your project -> Storage tab -> Create Database -> Upstash for Redis
# Vercel will offer to auto-add these env vars to your project. No separate app/backend
# to deploy anywhere else - it's just a managed database, accessed over REST from your
# existing Next.js API routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
